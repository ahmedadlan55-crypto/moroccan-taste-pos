    "test:scope-api": "node tests/integration/warehouseScope.api.test.js",
    "test:reports-api": "node tests/integration/reports.api.test.js",
    "test:transfers-api": "node tests/integration/transfers.api.test.js",
    "test:gl-concurrency": "node tests/integration/glConcurrency.api.test.js",
    "test:bootstrap": "node tests/integration/bootstrap.empty-db.test.js",
    "test:idempotency-retention": "node tests/integration/idempotencyRetention.test.js",
    "test:inv-tx-api": "node tests/integration/inventoryTx.api.test.js",
    "test:inv-tx-reverse-api": "node tests/integration/inventoryTxReverse.api.test.js",
    "test:stocktake-api": "node tests/integration/stocktake.api.test.js",
    "test:stocktake-concurrency": "node tests/integration/stocktakeConcurrency.test.js",
    "test:item-master-api": "node tests/integration/itemMaster.api.test.js",
    "test:replenishment-api": "node tests/integration/replenishment.api.test.js",
    "test:lots-api": "node tests/integration/lots.api.test.js",
    "test:lot-concurrency": "node tests/integration/lotConcurrency.test.js",
    "test:lot-writers": "node tests/integration/lotWriters.test.js",
    "test:stocktake-lots": "node tests/integration/stocktakeLots.test.js",
    "test:lot-integrity": "node tests/integration/lotIntegrity.api.test.js",
    "test:lot-migration": "node tests/integration/lotMigration.test.js",
    "test:security-api": "node tests/integration/securityHardening.api.test.js",
    "test:ops-api": "node tests/integration/ops.api.test.js",
    "test:flags-api": "node tests/integration/featureFlags.api.test.js",
    "warehouse:v2:preflight": "node scripts/warehouse-v2-preflight.js",
    "test:preflight": "node tests/integration/preflight.test.js",
    "migrate:purchase-lots": "node scripts/migrate-purchase-lots.js",
    "scope:backfill": "node scripts/backfill-warehouse-access.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "xlsx": "^0.18.5"
  }
