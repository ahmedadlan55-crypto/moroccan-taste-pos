{
  "name": "moroccan-taste-pos",
  "version": "1.0.0",
  "description": "Moroccan Taste POS/ERP System - Node.js + MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:warehouse",
