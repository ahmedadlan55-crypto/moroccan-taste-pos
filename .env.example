# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=moroccan_taste_pos

# Server
PORT=3000
NODE_ENV=production

# JWT Secret (generate a random string)
JWT_SECRET=change_this_to_a_random_secret_key_123

# Company Info
COMPANY_NAME=Moroccan Taste
TAX_NUMBER=314170726400003
CURRENCY=SAR
VAT_RATE=15

# Phase 4B — Lots / Expiry / FEFO (date-only, Asia/Riyadh)
EXPIRY_CRITICAL_DAYS=7          # ≤ N days to expiry → critical
EXPIRY_WARNING_DAYS=30          # ≤ N days to expiry → warning
EXPIRY_RECEIPT_MIN_DAYS=30      # receiving with < N days left → near-expiry warning
EXPIRY_BLOCK_NEAR_RECEIPT=0     # 1 = block (not just warn) near-expiry receipts
LOTS_EXPORT_MAX_ROWS=50000      # CSV export cap (reuses lib/csvExport)

# Phase 5A — Release Candidate (security / cutover / ops)
WAREHOUSE_V2_ENABLED=1                  # 0 = disable v2 SPA + block v2 WRITES (503); legacy fallback, no data loss
WAREHOUSE_SCOPE_ENFORCE=1              # 1 = enforce per-user warehouse scope (REQUIRED in staging/prod)
WAREHOUSE_V2_MUTATION_RATE_MAX=300    # per-user v2 mutations / window (0 = disabled)
WAREHOUSE_V2_MUTATION_RATE_WINDOW_MS=60000  # rate-limit window (ms)
ALLOWED_ORIGINS=                       # comma-separated; empty = dev allow-all; set in prod to restrict CORS
